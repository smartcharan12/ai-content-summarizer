# =============================================================================
# Copy to .env and edit:   cp .env.example .env      (Windows: copy .env.example .env)
# .env is git-ignored. NEVER commit real secrets.
# =============================================================================

# ---- Application -----------------------------------------------------------
APP_ENV=development              # development | staging | production
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*                   # in production list your real frontend origin(s)

# ---- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text                  # text | json  (json is easier to query in CloudWatch)
LOG_TO_FILE=true

# ---- Model -----------------------------------------------------------------
MODEL_SOURCE=registry            # registry | path
MODEL_NAME_OR_PATH=google/pegasus-xsum   # used when MODEL_SOURCE=path or no trained model exists
DEVICE=auto                      # auto | cpu | cuda | mps
GENERATION_PROFILE=optimized     # a profile name from config/params.yaml
LOAD_MODEL_ON_STARTUP=true

# ---- Input limits ----------------------------------------------------------
MIN_INPUT_WORDS=5
MAX_INPUT_CHARS=20000
MAX_BATCH_SIZE=8

# ---- Pipeline --------------------------------------------------------------
SMOKE_TEST=0                     # 1 = tiny model + small data subset (fast CPU test run)

# ---- Hugging Face (optional) ----------------------------------------------
# Only needed for gated models or to push your fine-tuned model to the Hub.
# HF_TOKEN=

# ---- AWS (needed only for deployment; prefer `aws configure` or an IAM role)
# AWS_REGION=ap-south-1
# AWS_ACCOUNT_ID=
# ECR_REPOSITORY=ai-content-summarizer
